;
; TabletMonitor.VirtualDisplay.inf
; Based on Microsoft's IndirectDisplay WDK sample.
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=TabletMonitor.VirtualDisplay.cat
DriverVer=

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...22000]
%DeviceName%=TabletMonitor_Install, Root\TabletMonitorVirtualDisplay
%DeviceName%=TabletMonitor_Install, TabletMonitorVirtualDisplay

[SourceDisksFiles]
TabletMonitor.VirtualDisplay.dll=1

[SourceDisksNames]
1=%DiskName%

[TabletMonitor_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[TabletMonitor_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=TabletMonitor_HardwareDeviceSettings

[TabletMonitor_HardwareDeviceSettings]
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "TabletMonitorVirtualDisplayGroup-0E6B4E25-3B2A-49D4-A78B-6B9545590EE2"

[TabletMonitor_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[TabletMonitor_Install.NT.Wdf]
UmdfService=TabletMonitorVirtualDisplay,TabletMonitorVirtualDisplay_Install
UmdfServiceOrder=TabletMonitorVirtualDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[TabletMonitorVirtualDisplay_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\TabletMonitor.VirtualDisplay.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF

[UMDriverCopy]
TabletMonitor.VirtualDisplay.dll

[Strings]
ManufacturerName="TabletMonitor"
DiskName="TabletMonitor Virtual Display Installation Disk"
DeviceName="TabletMonitor Virtual Display"

REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
